#!/usr/bin/env bash
# Privileged helper for KMS Console. Installed root-owned in /usr/local/sbin and
# the only command the web GUI (user kms) may run through sudo.
set -euo pipefail

APP_DIR=/opt/kms-console
VENV=/opt/kms-venv
CONF_DIR=/etc/kms-console
RUN_DIR=/run/kms-console
LOG=/var/log/kms-console-update.log
BRANCH_RE='^[A-Za-z0-9._/-]{1,100}$'

die() { echo "$*" >&2; exit 1; }
need_branch() { [[ "${1:-}" =~ $BRANCH_RE ]] && [[ "$1" != *..* ]] || die "invalid branch name"; }
json_str() { python3 -c 'import json,sys; print(json.dumps(sys.argv[1]))' "$1"; }

cmd="${1:-}"; shift || true
case "$cmd" in
  restart-server)
    systemctl restart kms-server.service
    sleep 1
    systemctl is-active --quiet kms-server.service || die "kms-server failed to start: $(journalctl -u kms-server -n 5 --no-pager -o cat | tail -n 3)"
    echo ok
    ;;

  restart-console)
    systemd-run --quiet --on-active=2 --unit="kms-console-restart-$(date +%s)" systemctl restart kms-console.service
    echo ok
    ;;

  status)
    . /etc/os-release
    printf '{"kms-server": %s, "kms-console": %s, "os": %s, "hostname": %s, "ip": %s, "uptime": %s, "commit": %s, "branch": %s}\n' \
      "$(json_str "$(systemctl is-active kms-server.service || true)")" \
      "$(json_str "$(systemctl is-active kms-console.service || true)")" \
      "$(json_str "$PRETTY_NAME")" "$(json_str "$(hostname -f 2>/dev/null || hostname)")" \
      "$(json_str "$(hostname -I | awk '{print $1}')")" "$(json_str "$(uptime -p)")" \
      "$(json_str "$(git -C "$APP_DIR" rev-parse --short HEAD 2>/dev/null || echo -)")" \
      "$(json_str "$(git -C "$APP_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null || echo -)")"
    ;;

  logs)
    n="${1:-200}"; [[ "$n" =~ ^[0-9]{1,4}$ ]] || n=200
    journalctl -u kms-server.service -n "$n" --no-pager -o short-iso | sed 's/\x1b\[[0-9;]*m//g'
    ;;

  check)
    branch="${1:-}"; need_branch "$branch"
    git -C "$APP_DIR" fetch --quiet origin "+refs/heads/$branch:refs/remotes/origin/$branch" 2>/dev/null \
      || die "branch '$branch' not found on $(git -C "$APP_DIR" remote get-url origin)"
    printf '{"local_commit": %s, "local_branch": %s, "remote_commit": %s, "remote_version": %s, "remote_date": %s, "remote_subject": %s}\n' \
      "$(json_str "$(git -C "$APP_DIR" rev-parse HEAD)")" \
      "$(json_str "$(git -C "$APP_DIR" rev-parse --abbrev-ref HEAD)")" \
      "$(json_str "$(git -C "$APP_DIR" rev-parse "origin/$branch")")" \
      "$(json_str "$(git -C "$APP_DIR" show "origin/$branch:VERSION" 2>/dev/null | head -n1 || echo unknown)")" \
      "$(json_str "$(git -C "$APP_DIR" log -1 --format=%cI "origin/$branch")")" \
      "$(json_str "$(git -C "$APP_DIR" log -1 --format=%s "origin/$branch")")"
    ;;

  update)
    branch="${1:-}"; need_branch "$branch"
    : > "$LOG"
    # Run detached so the update survives the restart of the web GUI that started it.
    systemd-run --quiet --unit="kms-console-update-$(date +%s)" --collect /usr/local/sbin/kms-ctl _do-update "$branch"
    echo "started"
    ;;

  _do-update)
    branch="${1:-}"; need_branch "$branch"
    exec >>"$LOG" 2>&1
    echo "[$(date -Is)] Update to branch $branch"
    if (
      set -e
      git -C "$APP_DIR" fetch origin "+refs/heads/$branch:refs/remotes/origin/$branch"
      # Refuse branches that do not contain KMS Console (for example the old Docker-only master)
      git -C "$APP_DIR" cat-file -e "origin/$branch:lxc/install.sh" 2>/dev/null \
        || { echo "Branch $branch does not contain KMS Console (lxc/install.sh missing). Nothing changed."; exit 1; }
      git -C "$APP_DIR" checkout -B "$branch" "origin/$branch"
      git -C "$APP_DIR" reset --hard "origin/$branch"
      echo "Now at $(cat "$APP_DIR/VERSION") ($(git -C "$APP_DIR" rev-parse --short HEAD))"
      bash "$APP_DIR/lxc/install.sh" --upgrade
    ); then
      echo "[$(date -Is)] UPDATE DONE"
    else
      echo "[$(date -Is)] UPDATE FAILED"
      exit 1
    fi
    ;;

  update-log)
    [[ -f "$LOG" ]] && tail -n 200 "$LOG" || echo "No update has run yet."
    ;;

  net-apply)
    # Load the firewall (nftables) and Caddy from network.json, written by the web GUI.
    # netrender.py validates everything again here, as root, before nft or Caddy see it.
    cfg="$CONF_DIR/network.json"
    nb=(); [[ "${1:-}" == "--boot" ]] && nb=(--no-block)   # at boot, do not wait for Caddy
    install -d -m 0750 "$RUN_DIR"
    if [[ ! -f "$cfg" ]]; then
      command -v nft >/dev/null && nft delete table inet kmsconsole 2>/dev/null || true
      systemctl disable --now --quiet caddy.service 2>/dev/null || true
      echo "ok (no network settings yet)"; exit 0
    fi
    mode="$(python3 -I "$APP_DIR/app/kmsconsole/netrender.py" "$cfg" "$RUN_DIR" 2>&1)" || die "$mode"
    if [[ -s "$RUN_DIR/kmsconsole.nft" ]]; then
      command -v nft >/dev/null || die "nftables is not installed. Run: apt install nftables"
      err="$(nft -c -f "$RUN_DIR/kmsconsole.nft" 2>&1)" \
        || die "The firewall rules could not be loaded: ${err:-unknown error}. In a Proxmox container the nf_tables module must be loaded on the host (modprobe nf_tables)."
      nft -f "$RUN_DIR/kmsconsole.nft"
    else
      command -v nft >/dev/null && nft delete table inet kmsconsole 2>/dev/null || true
    fi
    if [[ "$mode" == "caddy" ]]; then
      command -v caddy >/dev/null || die "Caddy is not installed. Run: apt install caddy"
      err="$(caddy validate --adapter caddyfile --config "$RUN_DIR/Caddyfile" 2>&1)" || die "Caddy configuration is invalid: $(echo "$err" | tail -n 2)"
      install -o root -g root -m 0644 "$RUN_DIR/Caddyfile" /etc/caddy/Caddyfile
      systemctl enable --quiet caddy.service
      systemctl "${nb[@]}" reload-or-restart caddy.service || die "Caddy failed to start: $(journalctl -u caddy -n 5 --no-pager -o cat | tail -n 3)"
    else
      systemctl disable --now --quiet caddy.service 2>/dev/null || true
    fi
    echo "ok $mode"
    ;;

  net-blocked)
    command -v nft >/dev/null || exit 0
    nft -j list set inet kmsconsole blocked4 2>/dev/null || true
    echo
    nft -j list set inet kmsconsole blocked6 2>/dev/null || true
    ;;

  net-status)
    printf '{"nft": %s, "caddy": %s, "table": %s}\n' \
      "$(json_str "$(command -v nft >/dev/null && echo installed || echo missing)")" \
      "$(json_str "$(systemctl is-active caddy.service 2>/dev/null || true)")" \
      "$(json_str "$(nft list table inet kmsconsole >/dev/null 2>&1 && echo loaded || echo none)")"
    ;;

  access-reset)
    # Locked out of the web interface? Run this in the Proxmox console (pct enter <id>).
    sudo -u kms env KMS_CONSOLE_ROOT="$APP_DIR" PYTHONPATH="$APP_DIR/app" "$VENV/bin/python" -c \
      'from kmsconsole import store, network; store.init(); network.reset_web_access()'
    "$0" net-apply
    echo "Web access list cleared. The web interface is open again on port 8080."
    ;;

  reset-password)
    user="${1:-admin}"
    [[ "$user" =~ ^[A-Za-z0-9._@-]{3,64}$ ]] || die "invalid username"
    pw="$(python3 -c 'import secrets; print(secrets.token_urlsafe(12))')"
    sudo -u kms env KMS_CONSOLE_ROOT="$APP_DIR" PYTHONPATH="$APP_DIR/app" "$VENV/bin/python" - "$user" "$pw" <<'EOF'
import sys, time
from werkzeug.security import generate_password_hash
from kmsconsole import store
store.init()
user, pw = sys.argv[1], sys.argv[2]
with store.connect() as con:
    cur = con.execute("UPDATE users SET password_hash=? WHERE username=?", (generate_password_hash(pw), user))
    if cur.rowcount == 0:
        con.execute("INSERT INTO users(username, password_hash, email, lang, created) VALUES(?,?,?,?,?)",
                    (user, generate_password_hash(pw), "", "en", int(time.time())))
EOF
    echo "New password for $user: $pw"
    ;;

  *)
    cat >&2 <<EOF
usage: kms-ctl <command>
  status                 service status as JSON
  restart-server         restart the KMS server
  restart-console        restart the web GUI
  logs [lines]           KMS server log
  check <branch>         compare installed version with a branch
  update <branch>        update KMS Console to a branch (runs in the background)
  update-log             output of the last update
  reset-password [user]  set a new random password (creates the user when missing)
  net-apply              load firewall and Caddy from network settings
  net-blocked            addresses blocked on the KMS port (nft JSON)
  net-status             firewall and Caddy state as JSON
  access-reset           clear the web access list (when locked out)
EOF
    exit 2
    ;;
esac
